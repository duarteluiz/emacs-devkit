;;; init.el --- Emacs DevKit: Ubuntu developer profile -*- lexical-binding: t; -*-
(setq user-emacs-directory (expand-file-name "~/.config/emacs/"))
(setq package-user-dir (expand-file-name "elpa" user-emacs-directory))
(require 'package)
(setq package-archives
      '(("gnu" . "https://elpa.gnu.org/packages/")
        ("nongnu" . "https://elpa.nongnu.org/nongnu/")
        ("melpa" . "https://melpa.org/packages/")))
(package-initialize)
;; No downloads during editor startup; install packages with ./install.sh.
(setq inhibit-startup-screen t
      ring-bell-function #'ignore
      make-backup-files t
      backup-directory-alist `(("." . ,(expand-file-name "backups" user-emacs-directory)))
      auto-save-file-name-transforms `((".*" ,(expand-file-name "auto-saves/" user-emacs-directory) t)))
(make-directory (expand-file-name "backups" user-emacs-directory) t)
(make-directory (expand-file-name "auto-saves" user-emacs-directory) t)
(menu-bar-mode -1)
(when (fboundp 'tool-bar-mode) (tool-bar-mode -1))
(when (fboundp 'scroll-bar-mode) (scroll-bar-mode -1))
(global-display-line-numbers-mode 1)
(global-hl-line-mode 1)
(column-number-mode 1)
(show-paren-mode 1)
(setq-default indent-tabs-mode nil tab-width 4 fill-column 100 c-basic-offset 4)
(when (and (display-graphic-p) (member "Fira Code" (font-family-list)))
  (set-face-attribute 'default nil :family "Fira Code" :height 115))
(when (require 'doom-themes nil t) (load-theme 'doom-one t))
(when (require 'doom-modeline nil t)
  (setq doom-modeline-icon nil)
  (doom-modeline-mode 1))
(when (require 'which-key nil t) (which-key-mode 1))
(when (require 'vertico nil t) (vertico-mode 1))
(when (require 'marginalia nil t) (marginalia-mode 1))
(when (require 'orderless nil t) (setq completion-styles '(orderless basic)))
(when (require 'consult nil t)
  (global-set-key (kbd "C-c s") #'consult-ripgrep)
  (global-set-key (kbd "C-c l") #'consult-line))
(when (require 'corfu nil t)
  (setq corfu-auto t corfu-auto-delay 0.2 corfu-auto-prefix 2 corfu-cycle t)
  (global-corfu-mode 1))
(when (require 'cape nil t)
  (add-to-list 'completion-at-point-functions #'cape-file))
(when (require 'rainbow-delimiters nil t)
  (add-hook 'prog-mode-hook #'rainbow-delimiters-mode))
(when (require 'projectile nil t) (projectile-mode 1))
(when (require 'treemacs nil t) (global-set-key (kbd "<f8>") #'treemacs))
(when (require 'magit nil t) (global-set-key (kbd "C-x g") #'magit-status))
;; Loading vterm during batch validation can trigger compilation. Load only when used.
(autoload 'vterm "vterm" "Open an interactive terminal." t)
(global-set-key (kbd "<f9>") #'vterm)
(require 'eglot)
(add-to-list 'eglot-server-programs
             '((c-mode c++-mode) . ("clangd" "--background-index" "--clang-tidy" "--completion-style=detailed")))
(add-hook 'c-mode-hook #'eglot-ensure)
(add-hook 'c++-mode-hook #'eglot-ensure)
(global-set-key (kbd "M-.") #'xref-find-definitions)
(global-set-key (kbd "M-,") #'xref-go-back)
(global-set-key (kbd "C-c r") #'eglot-rename)
(global-set-key (kbd "C-c a") #'eglot-code-actions)
;; F5 is provided by cpp-workflow.el.
(defun kit/format-cpp-buffer ()
  "Format the current C/C++ buffer using clang-format."
  (interactive)
  (unless (derived-mode-p 'c-mode 'c++-mode)
    (user-error "Open a C/C++ source file first"))
  (unless (executable-find "clang-format")
    (user-error "clang-format is not available"))
  (let ((source (current-buffer)))
    (with-temp-buffer
      (insert-buffer-substring source)
      (let ((exit-code (call-process-region (point-min) (point-max)
                                            "clang-format" t t nil)))
        (unless (and (integerp exit-code) (zerop exit-code))
          (error "clang-format failed"))
        (let ((formatted (buffer-string)))
          (with-current-buffer source
            (unless (string= formatted (buffer-string))
              (let ((old-point (point)))
                (atomic-change-group
                  (erase-buffer)
                  (insert formatted))
                (goto-char (min old-point (point-max)))))))))))
(global-set-key (kbd "C-c f") #'kit/format-cpp-buffer)
(load (expand-file-name "development.el" user-emacs-directory) t 'nomessage)
(load (expand-file-name "vscode-keys.el" user-emacs-directory) t 'nomessage)
(load (expand-file-name "simple-ui.el" user-emacs-directory) t 'nomessage)
(load (expand-file-name "cpp-workflow.el" user-emacs-directory) t 'nomessage)
(message "Emacs DevKit loaded.")
