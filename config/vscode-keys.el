;;; vscode-keys.el --- Familiar desktop editing shortcuts -*- lexical-binding: t; -*-
(cua-mode 1)
(delete-selection-mode 1)
(global-set-key (kbd "C-s") #'save-buffer)
(global-set-key (kbd "C-o") #'find-file)
(global-set-key (kbd "C-a") #'mark-whole-buffer)
(global-set-key (kbd "C-f") #'isearch-forward)
(global-set-key (kbd "C-p") #'project-find-file)
(global-set-key (kbd "C-S-p") #'execute-extended-command)
(global-set-key (kbd "C-S-s") #'write-file)
(global-set-key (kbd "C-S-z") #'undo-redo)
(global-set-key (kbd "C-S-h") #'query-replace)
;; Retain Ctrl+G for keyboard-quit and Ctrl+H for native Emacs help.
(defun kit/toggle-comment ()
  "Toggle comments in the active region or current line."
  (interactive)
  (if (use-region-p)
      (comment-or-uncomment-region (region-beginning) (region-end))
    (comment-line 1)))
(global-set-key (kbd "C-/") #'kit/toggle-comment)
(global-set-key (kbd "<f12>") #'xref-find-definitions)
(global-set-key (kbd "<f2>") #'eglot-rename)
(global-set-key (kbd "M-<left>") #'xref-go-back)
(global-set-key (kbd "C-S-e") #'treemacs)
(global-set-key (kbd "C-S-t") #'vterm)
